<?xml version="1.0" encoding="utf-8"?>
<!-- Winifred's launcher icon.
     An adaptive icon in one text file instead of five PNGs: minSdk is 26,
     so every phone that can install this app understands it, and there is
     no pixel size to get wrong on a screen nobody has seen yet. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/navy" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
