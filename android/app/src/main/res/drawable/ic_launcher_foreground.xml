<?xml version="1.0" encoding="utf-8"?>
<!-- Aurora Blink (--tone-5, #64FFDA) on her navy: the same orb as the app
     header, drawn as vectors so it stays sharp at any launcher size.
     Everything sits inside the 72dp safe zone of the 108dp canvas, so no
     launcher mask can crop the ring. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- the ring -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#64FFDA"
        android:strokeWidth="4"
        android:pathData="M54,24a30,30 0 1,0 0,60a30,30 0 1,0 0,-60z" />

    <!-- the core -->
    <path
        android:fillColor="#64FFDA"
        android:pathData="M54,41a13,13 0 1,0 0,26a13,13 0 1,0 0,-26z" />
</vector>
