<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The platform Material theme, not AppCompat: no libraries, on purpose.
         The navy background means the first frame is her colour, not white. -->
    <style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/navy</item>
        <item name="android:statusBarColor">@color/navy</item>
        <item name="android:navigationBarColor">@color/navy</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
